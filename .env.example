# n8n API Configuration
# Use http://localhost:5678 when running the Node script directly on your host.
# Docker Compose overrides this to http://n8n:5678 inside the app container.
N8N_HOST=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here

# Gmail Node Configuration
GMAIL_CREDENTIAL_ID=your_gmail_credential_id_here

# Microsoft 365 Outlook Node Configuration
OUTLOOK_CREDENTIAL_ID=your_outlook_credential_id_here

# Local Download Path
# OS-agnostic default when you run commands from this project folder.
LOCAL_DOWNLOAD_PATH=./downloads/

# Path used inside the n8n Docker container.
# Keep this in sync with the Docker volume mount in README.md.
N8N_CONTAINER_DOWNLOAD_PATH=/home/node/downloads/
